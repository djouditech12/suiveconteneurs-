<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_container_tracking" model="ir.module.category">
        <field name="name">Container Tracking</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_container_tracking" model="res.groups.privilege">
        <field name="name">Container Tracking</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_container_tracking"/>
    </record>

    <record id="group_container_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_container_tracking"/>
    </record>

    <record id="group_container_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_container_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_container_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
